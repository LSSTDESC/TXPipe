#!/usr/bin/env bash

# This line must stay first, and be valid in both bash/zsh and csh/tcsh. csh parses
# a script line by line, so it reaches this line before it hits any bash syntax.
# In csh "$?shell" is 1 (the variable "shell" is set); in bash/zsh it is "<status>shell",
# so the test is false.  In csh the "goto" to a non-existent label aborts the script
# without exiting (and so killing) the user's interactive shell; the label name is
# what shows up in the resulting error message.
test "$?shell" = 1 && echo "ERROR: setup-nersc does not work in csh or tcsh. Switch to bash or zsh and run: source bin/setup-nersc" && goto ERROR_this_script_requires_bash_or_zsh

# Inherited from cosmosis - checks if the script has been executed
# instead of sourced, under ZSH, KSH, and BASH
([[ -n $ZSH_EVAL_CONTEXT && $ZSH_EVAL_CONTEXT =~ :file$ ]] || 
[[ -n $KSH_VERSION && $(cd "$(dirname -- "$0")" &&
printf '%s' "${PWD%/}/")$(basename -- "$0") != "${.sh.file}" ]] || 
[[ -n $BASH_VERSION ]] && (return 0 2>/dev/null)) && sourced=1 || sourced=0



# This script should only be sourced
if [[ "${sourced}" == "0" ]]
then
    echo "You must source this script to use it, not execute it:"
    echo "source ${BASH_SOURCE[0]}"
    exit
fi

export DESCPYTHONUSERBASE=$(realpath $(dirname "${BASH_SOURCE[0]}")/..)/local
source /global/common/software/lsst/common/miniconda/setup_current_python.sh
unset PYTHONNOUSERSITE

echo "Using the central DESC conda environment."
echo "Install any extra packages into ${DESCPYTHONUSERBASE} using:"
echo "    pip install --user <packages>"
